 }
 
 
+=head2 ack_test_binary()
+
+If the ACK_TEST_BINARY environment variable is set, returns the absolute
+path of the executable it names.  The test suite then runs that executable
+directly instead of running blib/script/ack under perl.  This lets the
+suite be used against other implementations of ack.
+
+=cut
+
+sub ack_test_binary {
+    my $binary = $ENV{ACK_TEST_BINARY};
+    return unless defined($binary) && ($binary ne '');
+
+    return untaint( File::Spec->rel2abs( $binary, $orig_wd ) );
+}
+
+
 sub caret_X {
     return untaint( $^X ); # XXX How is it $^X can be tainted?  We should not have to untaint it.
 }
