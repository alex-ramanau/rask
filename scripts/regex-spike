#!/bin/sh
# Plan item 0.3: settle the regex engine (D1) with data.
#
#  1. Run the ack3 test suite against Perl ack with every built regex logged.
#  2. Deduplicate those regexes into a corpus.
#  3. Record Perl's matches for each one over the t/ fixture files.
#  4. Compare pcre2, fancy-regex and regex::bytes against Perl.
#
# Writes docs/regex-spike-results.md. Requires ACK3_DIR (default ../ack3),
# with the ACK_TEST_BINARY harness change and a built blib/.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
ACK3_DIR=$(cd "${ACK3_DIR:-$here/../ack3}" && pwd)
export ACK3_DIR
work="${CARGO_TARGET_DIR:-$here/target}/regex-spike"
rm -rf "$work"
mkdir -p "$work"

echo "== 1. running the ack3 suite with regex logging" >&2
(
    cd "$ACK3_DIR"
    RASK_REGEX_LOG="$work/log.jsonl" ACK_TEST_BINARY="$here/scripts/perl-ack-regex-log" \
        prove -b -r t/ >"$work/prove.log" 2>&1 || true
)
tail -1 "$work/prove.log" >&2

echo "== 2. building the corpus" >&2
perl -MJSON::PP -e '
    my $j = JSON::PP->new->canonical->ascii;
    my (%seen, @order);
    my $add = sub {
        my ($re, $site) = @_;
        return unless defined $re;
        my ($pat, $mods) = ref $re ? @$re : ($re, "");
        my $key = "$mods\0$pat";
        push @order, $key unless $seen{$key};
        $seen{$key}{pattern} = $pat;
        $seen{$key}{mods} = $mods;
        $seen{$key}{sites}{$site} = 1;
    };
    while (<STDIN>) {
        my $r = $j->decode($_);
        my $s = $r->{site};
        if ($s eq "build_regex") {
            if (exists $r->{error}) { $add->($r->{input}, "build_regex (rejected input)") }
            else { $add->($r->{regex}, "build_regex"); $add->($r->{scan}, "build_regex scan") }
        }
        elsif ($s eq "build_all_regexes") {
            $add->($r->{$_}, "build_all_regexes $_") for qw(match not_re hilite scan);
        }
        else { $add->($r->{regex}, $s) }
    }
    my $id = 0;
    for my $k (@order) {
        my $p = $seen{$k};
        print $j->encode({ id => $id++, pattern => $p->{pattern}, mods => $p->{mods},
                           sites => [ sort keys %{$p->{sites}} ] }), "\n";
    }
' <"$work/log.jsonl" >"$work/patterns.jsonl"
wc -l <"$work/patterns.jsonl" | sed 's/^/   patterns: /' >&2

echo "== 3. recording Perl matches" >&2
find "$ACK3_DIR/t/text" "$ACK3_DIR/t/swamp" "$ACK3_DIR/t/etc" "$ACK3_DIR/t/range" \
     "$ACK3_DIR"/t/*.yaml -type f | LC_ALL=C sort | xargs cat >"$work/haystack.bin"
perl "$here/tools/regex-spike/perl/perl-matches.pl" "$work/patterns.jsonl" "$work/haystack.bin" \
    >"$work/perl-results.jsonl"

echo "== 4. comparing engines" >&2
cargo run -q --release -p regex-spike --manifest-path "$here/Cargo.toml" -- \
    "$work/patterns.jsonl" "$work/haystack.bin" "$work/perl-results.jsonl" >"$work/report.md"
{
    echo "# Regex spike results"
    echo
    echo "Generated by \`scripts/regex-spike\` against ack3 \`$(git -C "$ACK3_DIR" rev-parse --short HEAD)\`,"
    echo "$(perl -e 'printf "perl %vd", $^V'). Don't edit by hand; see \`docs/regex-compat.md\` for the conclusions."
    echo
    cat "$work/report.md"
} >"$here/docs/regex-spike-results.md"
echo "wrote docs/regex-spike-results.md" >&2
